{
  "name": "bridge-system",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "husky install",
    "lint": "eslint .",
    "electron:build": "npm run build && electron-builder --win portable"
  },
  "build": {
    "appId": "com.bridge-system.app",
    "productName": "桥梁信息系统",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "portable": {
      "artifactName": "桥梁信息系统.exe"
    },
    "win": {
      "target": "portable"
    },
    "electronDownload": {
      "version": "28.0.0"
    }
  },
  "dependencies": {
    "axios": "^1.14.0",
    "china-area-data": "^5.0.1",
    "echarts": "^6.0.0",
    "element-plus": "^2.13.6",
    "less": "^4.6.4",
    "pinia": "^3.0.4",
    "three": "^0.184.0",
    "vue": "^3.5.30",
    "vue-echarts": "^8.0.1",
    "vue-router": "^5.0.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.5",
    "babel-plugin-component": "^1.1.1",
    "electron": "^28.0.0",
    "electron-builder": "^26.8.1",
    "eslint": "^10.2.0",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "mockjs": "^1.1.0",
    "vite": "^8.0.1",
    "vite-plugin-mock": "^3.0.2"
  }
}
